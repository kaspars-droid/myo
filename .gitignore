# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Built products. Myo Calc.app here is assembled by hand from .build, so it is
# output rather than source.
Myo Calc.app/
Myo Calc.zip
Myo Calc.pkg
DerivedData/

# The iOS archive and the IPA the release script exports.
build/

# The Mac App Store profile appstore-mac.sh embeds. It belongs to the Apple
# account and expires, so each machine downloads its own.
*.provisionprofile

# Xcode
*.xcuserstate
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# macOS
.DS_Store

# Xcode's own build output for the iOS app
myo/**/xcuserdata/

# Intermediate store art: the bare panels that Scripts/make-mac-mockups.swift
# composes onto a desktop, and the larger ones it crops the close-ups from.
# Regenerated by `swift run macshots`.
AppStore/mac/panels/
AppStore/mac/panels-closeup/

# The Figma file the store mockups were drawn from. Design source rather than
# app source, and a megabyte of it that no diff would ever be readable.
mockup ios.fig
