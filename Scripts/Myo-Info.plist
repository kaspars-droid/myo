<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>Myo Calc</string>
	<key>CFBundleDisplayName</key><string>Myo Calc</string>
	<!-- The identifier registered to the team, and the same one the phone app
	     uses, so the two are one app rather than two that share a name. -->
	<key>CFBundleIdentifier</key><string>lv.cirsis.myo</string>
	<key>CFBundleExecutable</key><string>Myo Calc</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1.0</string>
	<key>LSMinimumSystemVersion</key><string>15.0</string>
	<key>NSHighResolutionCapable</key><true/>
	<!-- Lives in the menu bar, so no Dock icon and no application menu. -->
	<key>LSUIElement</key><true/>

	<!-- Exported rather than imported: this is Myo's own document type now,
	     not another app's format being read. A sheet is still plain UTF-8
	     text, which is what it conforms to, so anything that opens text can
	     open one. -->
	<key>CFBundleIconFile</key><string>AppIcon</string>

	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>lv.cirsis.myo.sheet</string>
			<key>UTTypeDescription</key><string>Myo Calc Sheet</string>
			<key>UTTypeIconFile</key><string>Document</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.utf8-plain-text</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array><string>myocalc</string></array>
			</dict>
		</dict>
	</array>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Myo Calc Sheet</string>
			<key>CFBundleTypeIconFile</key><string>Document</string>
			<key>CFBundleTypeRole</key><string>Editor</string>
			<!-- Owner, because these are Myo's files and no one else's. -->
			<key>LSHandlerRank</key><string>Owner</string>
			<key>LSItemContentTypes</key>
			<array><string>lv.cirsis.myo.sheet</string></array>
		</dict>
	</array>
</dict>
</plist>
